# ====================================================================
# FACTORYGPT — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ====================================================================
# Duplicate this file to '.env.local' for local development.
# Configure these variables in your Vercel Project Environment Settings.

# --------------------------------------------------------------------
# 1. NEXT.JS PUBLIC SITE METADATA
# --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://factorygpt.vercel.app

# --------------------------------------------------------------------
# 2. SUPABASE DATABASE, AUTH & STORAGE (PHASE 2 & 3)
# --------------------------------------------------------------------
# Public URL and Anon Key (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Secret Service Role Key (SERVER-SIDE ONLY - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# --------------------------------------------------------------------
# 3. GOOGLE GEMINI MULTIMODAL LLM & EMBEDDING API (PHASE 3 & 4)
# --------------------------------------------------------------------
# Gemini API Key used for text-embedding-004 vector embeddings & gemini-1.5-flash RAG generation
GEMINI_API_KEY=your-google-gemini-api-key-here

# --------------------------------------------------------------------
# 4. VOICE ASSISTANT & MULTILINGUAL PREFERENCES (PHASE 4 & 5)
# --------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
NEXT_PUBLIC_VOICE_ENGINE_ENABLED=true
